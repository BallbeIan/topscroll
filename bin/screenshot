#!/bin/sh
# Saves a screenshot of the real settings window, for the README. It runs
# offscreen with a throwaway config, so it never touches your settings or desktop.
# Usage: bin/screenshot out.png [WIDTHxHEIGHT] [help|fine]   (set QT_SCALE_FACTOR=2 for a sharper image;
# "help" opens the shortcuts overlay, "fine" expands Fine-tune)
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
out=${1:?usage: bin/screenshot out.png [WIDTHxHEIGHT]}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/topscroll"
printf '[General]\nenabled=true\ncruise=true\n' > "$tmp/topscroll/topscroll.conf"
[ "$3" = help ] && export TOPSCROLL_HELP=1
[ "$3" = fine ] && export TOPSCROLL_FINE=1
XDG_CONFIG_HOME=$tmp QT_QPA_PLATFORM=offscreen TOPSCROLL_SIZE=${2:-480x1300} \
    TOPSCROLL_SCREENSHOT=$(realpath -m "$out") "$root/build/topscroll" open
