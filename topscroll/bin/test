#!/bin/sh
# Builds the Qt Test binary and runs it offscreen; it never touches real input devices.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$root/build/tests"
cd "$root/build/tests"
qmake6 "$root/tests/topscroll_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 ./topscroll_tests "$@"
